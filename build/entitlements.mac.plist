<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime exceptions for the Developer ID build (dmg + zip), used for
  the app and every helper. V8 needs both: JIT for the compiler, and
  unsigned executable memory for WebAssembly and regexp tiers. Nothing else is
  granted: no library-validation exception (nothing native is packed, and
  every binary is signed by the same team), no Apple Events, no camera or
  microphone. The Mac App Store build uses entitlements.mas*.plist instead.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
