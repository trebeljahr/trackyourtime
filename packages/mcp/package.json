{
  "name": "@starter/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Track Your Time: timers, entries, catalog and reports over the public REST API.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "trackyourtime-mcp": "./dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "test:integration": "node --import tsx --test src/tests/integration/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@starter/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
