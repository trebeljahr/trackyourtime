{
  "name": "@starter/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./trpc": {
      "types": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch --clear-screen=false --exclude \"../../node_modules/**\" src/index.ts",
    "test": "node --import tsx --test src/tests/*.test.ts ../../scripts/lib/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "admin": "tsx src/cli/admin.ts",
    "migrate:workspaces": "tsx src/scripts/migrate-to-workspaces.ts",
    "backfill:email-verified": "tsx src/scripts/backfill-email-verified.ts",
    "einvoice:samples": "tsx src/scripts/einvoice-samples.ts"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.66.0",
    "@sentry/node": "^10.75.0",
    "@starter/invoice-pdf": "workspace:*",
    "@starter/shared": "workspace:*",
    "@trpc/server": "^11.19.0",
    "better-auth": "1.7.5",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.10.1",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "stripe": "^22.6.2",
    "use-intl": "^4.14.5",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/morgan": "^1.9.9",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qs": "^6.15.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
