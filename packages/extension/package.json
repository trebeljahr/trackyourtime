{
  "name": "@starter/extension",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:firefox": "vite build --mode firefox",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "dev:prod": "vite build --watch --mode production",
    "hmr": "node scripts/hmr.mjs",
    "hmr:local": "node scripts/hmr.mjs --local",
    "test:hmr": "node --test scripts/hmr-options.test.mjs scripts/hmr-port.test.mjs"
  },
  "dependencies": {
    "@starter/core": "workspace:*",
    "@starter/shared": "workspace:*",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "use-intl": "^4.14.9"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
