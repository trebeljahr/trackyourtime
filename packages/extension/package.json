{
  "name": "@starter/extension",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:firefox": "vite build --mode firefox",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "dev:prod": "vite build --watch --mode production",
    "hmr": "node scripts/hmr.mjs",
    "hmr:local": "node scripts/hmr.mjs --local",
    "test:hmr": "node --test scripts/hmr-options.test.mjs scripts/hmr-port.test.mjs"
  },
  "dependencies": {
    "@starter/core": "workspace:*",
    "@starter/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "use-intl": "^4.14.7",
    "lucide-react": "^1.48.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.2.7",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
