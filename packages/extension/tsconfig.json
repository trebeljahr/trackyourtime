{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The base config targets Node (module NodeNext, emitting declarations).
    // Vite bundles this package instead, so resolution is bundler-style and
    // nothing is emitted — tsc is only ever run as a type checker here.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vite/client"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"],
  // Tests run in Node under Vitest and are checked by tsconfig.test.json; the
  // extension itself must keep compiling without Node's globals.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}
