{
  "name": "@starter/invoice-pdf",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@starter/shared": "workspace:*",
    "pdfkit": "^0.20.2",
    "use-intl": "^4.14.4"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.22.0",
    "typescript": "^7.0.2"
  }
}
