// The hosted web app, https://trackyourtime.dev: an assets-only Cloudflare
// Worker serving the static export. docs/deploy.md → Web app on Cloudflare.
//
// Deliberately absent, each for a reason that fails quietly:
// - `main`: no script, so no request counts toward the Workers Free daily
//   request limit. A script (or `run_worker_first`, or `cache`) would make
//   every page and asset request a billed invocation.
// - `routes`: the routes live on the zone, made once by hand —
//   `trackyourtime.dev/*` → this Worker, and
//   `trackyourtime.dev/.well-known/acme-challenge/*` → no Worker, so the
//   origin's certificate keeps renewing. With no `routes` key, Wrangler leaves
//   them alone on every upload, and CI's per-Worker token needs no zone access.
// - `workers_dev` and `preview_urls`: off, so the site has one address.
//
// The API is a separate origin (api.trackyourtime.dev) and never passes
// through here. The upload is packages/client/out after
// scripts/cloudflare-static.mjs and scripts/static-carry.mjs ran on it
// (build-and-deploy.yml → build-client).
{
  "name": "trackyourtime-client",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "packages/client/out",
    // `trailingSlash: true` export: /x/ serves x/index.html and /x redirects to /x/.
    "html_handling": "auto-trailing-slash",
    // The nearest 404.html up the path: out/docs/404.html under /docs/, out/404.html elsewhere.
    "not_found_handling": "404-page"
  }
}
