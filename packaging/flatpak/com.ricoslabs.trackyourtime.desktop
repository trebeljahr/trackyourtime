[Desktop Entry]
Type=Application
Name=Track Your Time
Comment=Free, open-source time tracking
Exec=trackyourtime %U
Icon=com.ricoslabs.trackyourtime
Categories=Office;ProjectManagement;
Keywords=time;tracking;timesheet;billable;invoice;timer;freelance;
# The executable's name, as in the deb, rpm and AppImage entries
# (build/linux/trackyourtime.desktop.hbs). Without it a running window is not
# matched to this entry, and the shell shows a generic icon.
StartupWMClass=trackyourtime
Terminal=false
