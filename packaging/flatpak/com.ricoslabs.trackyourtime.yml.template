# Flathub manifest. Rendered by `node scripts/desktop-manifests.mjs` and
# committed to the flathub/com.ricoslabs.trackyourtime repository, which is
# where Flathub builds from — never built by this repo's CI.
#
# It repackages the release's linux tar.gz rather than building from source:
# the app is a static export embedded into one Rust executable, and rebuilding
# the Next.js export and the cargo build offline inside flatpak-builder would
# need every npm and crates.io dependency vendored as a source. Flathub's own
# requirements page says source-available submissions are built from source,
# and its moderators say a manifest may repackage the upstream binary instead
# (https://discourse.flathub.org/t/best-way-to-submit-new-app-sources-or-binary/8668).
# What the rule forbids is a binary committed INTO the pull request, which this
# manifest has none of. A reviewer may still ask for a source build; that build
# needs flatpak-node-generator and flatpak-cargo-generator, which this repo has
# not run (docs/linux-stores.md).
#
# The executable links WebKitGTK 4.1 and GTK 3, which the GNOME runtime
# carries; the tray's Ayatana AppIndicator is not in it and comes from Flathub's
# shared-modules, which the Flathub repository adds as a git submodule.
# Check the runtime version against Flathub's supported list at submission.
#
# Every `x-checker-data` block lets Flathub's flatpak-external-data-checker
# raise the version by itself after the first submission. It reads
# `releases/latest`, which is the newest PUBLISHED, non-prerelease release —
# the same decision point as the draft release a person publishes. The bot
# rewrites these URLs and checksums; it does not touch the metainfo's
# screenshots.
app-id: com.ricoslabs.trackyourtime
runtime: org.gnome.Platform
runtime-version: "49"
sdk: org.gnome.Sdk
command: trackyourtime
separate-locales: false
finish-args:
  - --share=ipc
  - --share=network
  - --socket=wayland
  - --socket=fallback-x11
  - --device=dri
  # System notifications for the idle and runaway prompts.
  - --talk-name=org.freedesktop.Notifications
  # The tray icon (StatusNotifierItem).
  - --talk-name=org.kde.StatusNotifierWatcher
  # The session token is kept in the Secret Service; without it the app keeps
  # the token in memory only and says so in Settings → Devices.
  - --talk-name=org.freedesktop.secrets
modules:
  # The tray: Flathub's own shared module for libayatana-appindicator (the
  # flathub/shared-modules submodule of the app's Flathub repository). The app
  # dlopens it, so without it there is no tray icon rather than a crash.
  - shared-modules/libayatana-appindicator/libayatana-appindicator-gtk3.json
  - name: trackyourtime
    buildsystem: simple
    build-commands:
      - install -Dm755 app/trackyourtime /app/bin/trackyourtime
      - install -Dm644 com.ricoslabs.trackyourtime.desktop /app/share/applications/com.ricoslabs.trackyourtime.desktop
      - install -Dm644 com.ricoslabs.trackyourtime.metainfo.xml /app/share/metainfo/com.ricoslabs.trackyourtime.metainfo.xml
      - install -Dm644 icon.png /app/share/icons/hicolor/512x512/apps/com.ricoslabs.trackyourtime.png
      # Flathub requires the licence in the build.
      - install -Dm644 LICENSE /app/share/licenses/com.ricoslabs.trackyourtime/LICENSE
    sources:
      - type: archive
        only-arches:
          - x86_64
        url: https://github.com/trebeljahr/trackyourtime/releases/download/v{{version}}/TrackYourTime-{{version}}-linux-x64.tar.gz
        sha256: {{sha256_linux_x64_targz}}
        dest: app
        x-checker-data:
          type: json
          url: https://api.github.com/repos/trebeljahr/trackyourtime/releases/latest
          tag-query: .tag_name
          version-query: .tag_name | sub("^v"; "")
          timestamp-query: .published_at
          url-query: .assets[] | select(.name|test("-linux-x64\\.tar\\.gz$")).browser_download_url
      - type: archive
        only-arches:
          - aarch64
        url: https://github.com/trebeljahr/trackyourtime/releases/download/v{{version}}/TrackYourTime-{{version}}-linux-arm64.tar.gz
        sha256: {{sha256_linux_arm64_targz}}
        dest: app
        x-checker-data:
          type: json
          url: https://api.github.com/repos/trebeljahr/trackyourtime/releases/latest
          tag-query: .tag_name
          version-query: .tag_name | sub("^v"; "")
          timestamp-query: .published_at
          url-query: .assets[] | select(.name|test("-linux-arm64\\.tar\\.gz$")).browser_download_url
      - type: file
        path: com.ricoslabs.trackyourtime.desktop
      - type: file
        path: com.ricoslabs.trackyourtime.metainfo.xml
      # Both are read from the repository at the release tag, so they move with
      # the archives above rather than with whatever main holds today.
      - type: file
        url: https://raw.githubusercontent.com/trebeljahr/trackyourtime/v{{version}}/build/icon.png
        sha256: {{sha256_icon_png}}
        dest-filename: icon.png
        x-checker-data:
          type: json
          url: https://api.github.com/repos/trebeljahr/trackyourtime/releases/latest
          version-query: .tag_name | sub("^v"; "")
          url-query: '"https://raw.githubusercontent.com/trebeljahr/trackyourtime/" + .tag_name + "/build/icon.png"'
      - type: file
        url: https://raw.githubusercontent.com/trebeljahr/trackyourtime/v{{version}}/LICENSE
        sha256: {{sha256_license}}
        dest-filename: LICENSE
        x-checker-data:
          type: json
          url: https://api.github.com/repos/trebeljahr/trackyourtime/releases/latest
          version-query: .tag_name | sub("^v"; "")
          url-query: '"https://raw.githubusercontent.com/trebeljahr/trackyourtime/" + .tag_name + "/LICENSE"'
