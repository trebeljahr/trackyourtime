# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.9.0.schema.json
# One NSIS installer per architecture (the Tauri bundler builds one per Rust
# target; x64 keeps the name the Electron installer, which carried both, had).
# Per-user (bundle.windows.nsis.installMode currentUser): no elevation prompt.
PackageIdentifier: ricoslabs.trackyourtime
PackageVersion: {{version}}
InstallerType: nullsoft
Scope: user
InstallModes:
  - silent
  - silentWithProgress
UpgradeBehavior: install
ReleaseDate: {{release_date}}
Installers:
  - Architecture: x64
    InstallerUrl: https://github.com/trebeljahr/trackyourtime/releases/download/v{{version}}/TrackYourTime-Setup-{{version}}.exe
    InstallerSha256: {{sha256_win_nsis}}
  - Architecture: arm64
    InstallerUrl: https://github.com/trebeljahr/trackyourtime/releases/download/v{{version}}/TrackYourTime-Setup-{{version}}-arm64.exe
    InstallerSha256: {{sha256_win_nsis_arm64}}
ManifestType: installer
ManifestVersion: 1.9.0
